# Copy to /etc/fixy-backend.env and chmod 600

PORT=8080

FIXY_OPS_USERNAME=change-me
FIXY_OPS_PASSWORD=change-me

# Refundación de Fixy, fase 1 (2026-09-14). Categorías con precio cerrado
# habilitadas para pedir (catálogo público + puerta de pedido estructurado).
FIXY_ORDERS_ACTIVE_CATEGORIES=aires_acondicionados,plomeria,barometrica
# Congela ofertas y comercios (schedulers + altas/consultas públicas) hasta
# que la fase de ofertas se retome. false = pausado (default de esta fase).
FIXY_OFFERS_ENABLED=false
# Nunca en true en prod: sembraría proveedores ficticios (ver
# ProviderSeedConfig, incidente de los 6 proveedores de prueba en prod).
FIXY_SEED_PROVIDERS=false

# Refundación de Fixy, fase 2 (2026-09-15). El modelo de cobro pasa de
# "Fixy le cobra comisión al técnico" a "Fixy le cobra un cargo de servicio
# al vecino" por Mercado Pago — garantía 30 días + reseña verificada + recibo.
# MP_ACCESS_TOKEN ya está configurado en prod (comisión pagada en agosto), así
# que los links de cargo al cliente salen solos desde el primer arranque.
FIXY_SERVICE_FEE_PERCENT=15
FIXY_SERVICE_FEE_ENABLED=true
# Reemplaza a FIXY_PAYMENTS_ENABLED (fixy.payments.enabled): default false
# desde este deploy — deja de crearse LeadPayment (comisión al técnico) para
# trabajos nuevos. Lo histórico sigue visible en el admin, pestaña Comisiones.
FIXY_PROVIDER_COMMISSION_ENABLED=false
FIXY_GUARANTEE_DAYS=30

# Casa a distancia (plan mensual para dueños que no viven en la propiedad).
FIXY_REMOTE_CARE_MONTHLY_PRICE=1900
FIXY_REMOTE_CARE_VISIT_SERVICE_CODE=care_visita
FIXY_REMOTE_CARE_BILLING_ENABLED=true
FIXY_CUSTOMER_PAYMENTS_REMINDER_ENABLED=true

# Un solo scheduler de matching (MatchingWatchdogScheduler) reemplaza a
# fixy.stale-matching.*, fixy.matching.auto-release.* y
# fixy.orphan-match-retry.* (las tres clases viejas se borraron).
FIXY_MATCHING_WATCHDOG_ENABLED=true
FIXY_MATCHING_WATCHDOG_STALE_MINUTES=45
FIXY_MATCHING_WATCHDOG_STALE_MINUTES_REMOTE_CARE=20
FIXY_MATCHING_WATCHDOG_RELEASE_HOURS=12
FIXY_MATCHING_WATCHDOG_RELEASE_HOURS_REMOTE_CARE=4
FIXY_MATCHING_WATCHDOG_ORPHAN_MAX_AGE_DAYS=14
FIXY_MATCHING_WATCHDOG_ORPHAN_RETRY_MINUTES=60

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Google Sign-In (proveedores, comercios, app users) — sin esto, todos los
# endpoints /api/public/auth/google* devuelven 503 (ver application.yml:125-126)
GOOGLE_CLIENT_ID=
# Secreto HMAC del session token propio (AppUser), min 32 bytes
AUTH_SESSION_SECRET=

# WhatsApp Cloud API (ver WHATSAPP_CLOUD_API_SETUP.md paso 6-8). Con estas
# 4 vacias el canal completo (incluido el menu de apertura) queda en modo
# disabled — no-op seguro, no rompe nada mientras Meta no este listo.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
# Defaults razonables, solo tocar si Meta pide otra cosa.
WHATSAPP_API_VERSION=v21.0
WHATSAPP_TEMPLATE_NAME=provider_lead_notification
WHATSAPP_TEMPLATE_LANG=es
#
# --- Alternativa: BSP (Business Solution Provider) en vez de Meta directo ---
# Uso: si tu cuenta de Meta no puede pasar el registro de developer, un BSP
# ya certificado (360dialog, Twilio, etc.) da de alta el numero por vos y
# expone una API compatible con el mismo formato de mensajes/webhooks — solo
# cambia el host, el path y el header de auth. Para 360dialog:
#   WHATSAPP_PHONE_NUMBER_ID=cualquier-valor-no-vacio   # solo habilita el flag enabled, no se usa en el path
#   WHATSAPP_ACCESS_TOKEN=<tu D360-API-KEY>
#   WHATSAPP_BASE_URL=https://waba-sandbox.360dialog.io   # prod: https://waba-v2.360dialog.io (confirmar path exacto antes de pasar a prod)
#   WHATSAPP_AUTH_SCHEME=d360-api-key
#   WHATSAPP_MESSAGES_PATH=/v1/messages
#   WHATSAPP_APP_SECRET=   # vacio: 360dialog no firma el webhook igual que Meta, se salta la validacion HMAC
WHATSAPP_BASE_URL=https://graph.facebook.com
WHATSAPP_AUTH_SCHEME=bearer
WHATSAPP_MESSAGES_PATH=
# Menu de apertura (interactive list al primer contacto): kill-switch propio.
WHATSAPP_MENU_ENABLED=true
WHATSAPP_MENU_BUTTON_LABEL=Ver opciones

SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/fixy
SPRING_DATASOURCE_DRIVER_CLASS_NAME=org.postgresql.Driver
SPRING_DATASOURCE_USERNAME=fixy
SPRING_DATASOURCE_PASSWORD=change-me
# NUNCA `update` en prod (incidente 2026-07-22: Hibernate autocreando/rompiendo
# esquema en cada boot en vez de dejarle el schema a Flyway). Prod es
# Postgres + Flyway dueño del esquema (ver comentario en application.yml:14-22)
# — `validate` falla el boot si las entidades no matchean el schema
# migrado, en vez de tocarlo. Todo cambio de esquema = migración nueva en
# db/migration, nunca ddl-auto.
SPRING_JPA_HIBERNATE_DDL_AUTO=validate
SPRING_FLYWAY_ENABLED=true
SPRING_JPA_PROPERTIES_HIBERNATE_DIALECT=org.hibernate.dialect.PostgreSQLDialect
