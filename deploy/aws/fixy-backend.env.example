# Copy to /etc/fixy-backend.env and chmod 600

PORT=8080

FIXY_OPS_USERNAME=change-me
FIXY_OPS_PASSWORD=change-me

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# WhatsApp Cloud API (ver WHATSAPP_CLOUD_API_SETUP.md paso 6-8). Con estas
# 4 vacias el canal completo (incluido el menu de apertura) queda en modo
# disabled — no-op seguro, no rompe nada mientras Meta no este listo.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
# Defaults razonables, solo tocar si Meta pide otra cosa.
WHATSAPP_API_VERSION=v21.0
WHATSAPP_TEMPLATE_NAME=provider_lead_notification
WHATSAPP_TEMPLATE_LANG=es
#
# --- Alternativa: BSP (Business Solution Provider) en vez de Meta directo ---
# Uso: si tu cuenta de Meta no puede pasar el registro de developer, un BSP
# ya certificado (360dialog, Twilio, etc.) da de alta el numero por vos y
# expone una API compatible con el mismo formato de mensajes/webhooks — solo
# cambia el host, el path y el header de auth. Para 360dialog:
#   WHATSAPP_PHONE_NUMBER_ID=cualquier-valor-no-vacio   # solo habilita el flag enabled, no se usa en el path
#   WHATSAPP_ACCESS_TOKEN=<tu D360-API-KEY>
#   WHATSAPP_BASE_URL=https://waba-sandbox.360dialog.io   # prod: https://waba-v2.360dialog.io (confirmar path exacto antes de pasar a prod)
#   WHATSAPP_AUTH_SCHEME=d360-api-key
#   WHATSAPP_MESSAGES_PATH=/v1/messages
#   WHATSAPP_APP_SECRET=   # vacio: 360dialog no firma el webhook igual que Meta, se salta la validacion HMAC
WHATSAPP_BASE_URL=https://graph.facebook.com
WHATSAPP_AUTH_SCHEME=bearer
WHATSAPP_MESSAGES_PATH=
# Menu de apertura (interactive list al primer contacto): kill-switch propio.
WHATSAPP_MENU_ENABLED=true
WHATSAPP_MENU_BUTTON_LABEL=Ver opciones

SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/fixy
SPRING_DATASOURCE_DRIVER_CLASS_NAME=org.postgresql.Driver
SPRING_DATASOURCE_USERNAME=fixy
SPRING_DATASOURCE_PASSWORD=change-me
SPRING_JPA_HIBERNATE_DDL_AUTO=update
SPRING_JPA_PROPERTIES_HIBERNATE_DIALECT=org.hibernate.dialect.PostgreSQLDialect
