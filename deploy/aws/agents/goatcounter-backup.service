[Unit]
Description=GoatCounter SQLite backup (online .backup, retención 14 días)
After=goatcounter.service

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/opt/fixy-agents/goatcounter-backup.sh
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/backups/goatcounter
ReadOnlyPaths=/var/lib/goatcounter
StandardOutput=append:/var/log/fixy-agents.log
StandardError=append:/var/log/fixy-agents.log
